---
const metrics = [
  { label: 'Accuracy', value: '77.60', suffix: '%', desc: 'Akurasi keseluruhan', gradient: 'from-blue-500 to-cyan-400' },
  { label: 'Precision', value: '77.49', suffix: '%', desc: 'Weighted average', gradient: 'from-violet-500 to-purple-400' },
  { label: 'Recall', value: '77.60', suffix: '%', desc: 'Weighted average', gradient: 'from-emerald-500 to-green-400' },
  { label: 'F1-Score', value: '77.50', suffix: '%', desc: 'Weighted average', gradient: 'from-amber-500 to-orange-400' },
];

const perClass = [
  { name: 'Lancar', precision: '80.00%', recall: '75.00%', f1: '77.42%', support: 64 },
  { name: 'Sedang', precision: '67.19%', recall: '67.19%', f1: '67.19%', support: 64 },
  { name: 'Padat', precision: '85.29%', recall: '90.62%', f1: '87.88%', support: 64 },
];

const cm = [
  [48, 15, 1],
  [12, 43, 9],
  [0, 6, 58],
];
---

<section id="results" class="py-24 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-white via-blue-50/20 to-white"></div>
  <div class="section-container relative z-10">
    <div class="text-center mb-16">
      <p class="reveal text-sm text-muted-foreground mb-2">Evaluasi Model</p>
      <h2 class="reveal reveal-delay-1 text-3xl font-bold tracking-tight">Hasil Model</h2>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      {metrics.map((m, i) => (
        <div class={`reveal reveal-delay-${i + 1} metric-card group`}>
          <div class={`text-3xl font-bold tracking-tight bg-gradient-to-r ${m.gradient} bg-clip-text text-transparent group-hover:scale-110 transition-transform duration-300 inline-block`}>
            <span class="counter" data-target={m.value}>0</span>{m.suffix}
          </div>
          <div class="text-sm font-medium mt-1">{m.label}</div>
          <div class="text-xs text-muted-foreground mt-0.5">{m.desc}</div>
        </div>
      ))}
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      <div class="reveal reveal-left card">
        <h3 class="font-semibold mb-4">Classification Report</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-100">
                <th class="text-left py-2 font-medium text-muted-foreground">Kelas</th>
                <th class="text-right py-2 font-medium text-muted-foreground">Precision</th>
                <th class="text-right py-2 font-medium text-muted-foreground">Recall</th>
                <th class="text-right py-2 font-medium text-muted-foreground">F1</th>
                <th class="text-right py-2 font-medium text-muted-foreground">N</th>
              </tr>
            </thead>
            <tbody>
              {perClass.map((cls) => (
                <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition-colors">
                  <td class="py-2.5 font-medium">{cls.name}</td>
                  <td class="py-2.5 text-right text-muted-foreground">{cls.precision}</td>
                  <td class="py-2.5 text-right text-muted-foreground">{cls.recall}</td>
                  <td class="py-2.5 text-right text-muted-foreground">{cls.f1}</td>
                  <td class="py-2.5 text-right text-muted-foreground">{cls.support}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="reveal reveal-right card">
        <h3 class="font-semibold mb-4">Confusion Matrix</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-100">
                <th class="text-left py-2 font-medium text-muted-foreground">Aktual ↓ / Prediksi →</th>
                {['Lancar', 'Sedang', 'Padat'].map((h) => (
                  <th class="text-center py-2 font-medium text-muted-foreground">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {cm.map((row, i) => (
                <tr class="border-b border-slate-50">
                  <td class="py-2.5 font-medium">{['Lancar', 'Sedang', 'Padat'][i]}</td>
                  {row.map((val, j) => {
                    const isDiag = i === j;
                    return (
                      <td
                        class={`py-2.5 text-center font-mono transition-colors hover:bg-blue-50 ${isDiag ? 'font-bold text-foreground' : 'text-muted-foreground'}`}
                        style={isDiag ? `background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(139, 92, 246, 0.1))` : val > 10 ? `background: rgba(239, 68, 68, 0.08)` : ''}
                      >
                        {val}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-muted-foreground mt-4">
          Model paling akurat di kelas <strong>Padat</strong> (recall 90.6%), sedangkan kelas
          <strong> Sedang</strong> masih memiliki error tertinggi.
        </p>
      </div>
    </div>
  </div>
</section>
