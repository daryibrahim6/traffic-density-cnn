---
const navItems = [
  { label: 'Tentang', href: '#about' },
  { label: 'Dataset', href: '#dataset' },
  { label: 'Hasil', href: '#results' },
  { label: 'Demo', href: '#demo' },
  { label: 'Tim', href: '#team' },
];
---

<footer class="py-8 relative border-t-0">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
  <div class="section-container">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <span class="inline-flex w-6 h-6 rounded-lg bg-gradient-to-br from-blue-500 to-violet-600 text-white items-center justify-center shadow-sm">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
          </svg>
        </span>
        <span>&copy; 2026 Kelompok 3</span>
      </div>

      <nav class="flex items-center gap-4 text-xs text-muted-foreground">
        {navItems.map((item) => (
          <a href={item.href} class="hover:text-foreground transition-colors">{item.label}</a>
        ))}
      </nav>

      <a href="#" class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors group" aria-label="Kembali ke atas">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:-translate-y-0.5 transition-transform">
          <path d="M18 15l-6-6-6 6" />
        </svg>
        Kembali ke atas
      </a>
    </div>
  </div>
</footer>
